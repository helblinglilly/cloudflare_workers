{
  "name": "mp4-web",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "mp4.helbling.uk",
      "custom_domain": true
    }
  ]
}
